# Library Management System - Environment Configuration

# Library Settings
LIBRARY_NAME=City Library
MAX_BOOKS_PER_MEMBER=5
LOAN_PERIOD_DAYS=14
LATE_FEE_PER_DAY=0.50

# Storage Configuration
STORAGE_PATH=data/library_data.json
STORAGE_TYPE=json  # Options: json, sqlite

# Database Configuration (if using SQLite)
DATABASE_URL=sqlite:///data/library.db

# Logging Configuration
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_DIR=logs
ENABLE_AUDIT_LOG=true

# Application Settings
ENV=development  # Options: development, production, testing
DEBUG=false

# Security Settings
SECRET_KEY=your-secret-key-here-change-in-production
ENABLE_RATE_LIMITING=false
